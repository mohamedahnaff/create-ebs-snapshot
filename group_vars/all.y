---
# Default region
aws_region_default: eu-north-1

# Snapshot tag defaults
snapshot_created_by: "AAP"
snapshot_purpose: "PreChangeBackup"

# ServiceNow connection
# Replace these with your real values if you test locally.
# In AAP production, use credentials instead of plain text.
snow_instance_url: "https://YOUR_INSTANCE.service-now.com"
snow_username: "admin"
snow_password: "YOUR_PASSWORD"
